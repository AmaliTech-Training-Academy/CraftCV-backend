SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Postgres. These values are also read by Docker Compose, which creates the
# database with them, so the app and the container stay in step.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=craftcv
DB_USER=craftcv
DB_PASSWORD=craftcv
DB_HOST=127.0.0.1
DB_PORT=5432

# Host port the compose database is published on, and the port the app is
# served on. Change either if something already uses it.
DB_HOST_PORT=5432
WEB_PORT=8000

# Without any DB_ENGINE the project falls back to a local SQLite file, which is
# what the test suite and CI use:
# DB_ENGINE=django.db.backends.sqlite3
