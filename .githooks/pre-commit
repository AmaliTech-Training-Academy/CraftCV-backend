#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
validate="$repo_root/scripts/validate-conventions.sh"
branch=$(git symbolic-ref --quiet --short HEAD || true)

if [ -n "$branch" ]; then
  if sh "$validate" is-protected "$branch"; then
    printf '%s\n' "Direct commits to '$branch' are not allowed. Create a branch first:" >&2
    printf '%s\n' "    git switch -c feat/crf-<ticket-number>-<short-description>" >&2
    exit 1
  fi
  sh "$validate" branch "$branch"
fi

git diff --cached --check

# Lint is fast, so it runs on every commit. Tests and the build run on push.
sh "$repo_root/scripts/check.sh" lint --staged
